# Local Finder — environment variables.
# Copy to .env.local for local dev. Never commit real keys.
# This file is committed to git: keep ALL values empty here.

# SerpApi key (google_maps + google_maps_reviews engines).
# Only used when USE_MOCK=false. The key never reaches the browser.
SERPAPI_KEY=

# Groq free-tier key for the optional AI layer (query parsing, review summaries).
# When empty, AI features degrade gracefully (raw query fallback, summary hidden).
GROQ_API_KEY=
# Model for Groq chat completions (default: openai/gpt-oss-120b).
GROQ_MODEL=openai/gpt-oss-120b

# Mock mode: serve mock/search.json + mock/reviews.json instead of SerpApi.
# Default true (anything other than "false"). Set false in production.
USE_MOCK=true

# Monthly SerpApi call budget before QUOTA_EXCEEDED is returned.
MONTHLY_CALL_LIMIT=200

# Optional Upstash Redis (L2 cache). When unset, the in-memory cache is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional PostgreSQL (favorites, search logs, quota counter).
# When unset, favorites use localStorage and counters stay in memory.
DATABASE_URL=
